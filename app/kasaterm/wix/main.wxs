<?xml version='1.0' encoding='utf-8'?>
<!--
  KasaLite 의 Windows 설치본. 본판 kasaterm 의 WiX 템플릿에서 라이트가 안 쓰는
  것을 걷어낸 판이다 — WinSparkle(자동 업데이트)·arona-ui(웹뷰)·collab-hooks
  (학생 로스터)가 없으니 exe 둘과 한글 폰트만 깐다.

  ⚠️ UpgradeCode 는 본판과 **절대** 같으면 안 된다. 같으면 MajorUpgrade 가
  둘을 한 제품으로 보고, KasaLite 를 깔 때 설치돼 있던 kasaterm 을 지운다.
  Path 컴포넌트의 고정 GUID 도 같은 이유로 갈라 뒀다(한쪽을 지울 때 남은
  쪽의 PATH 가 함께 사라진다).
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='KasaLite'
        UpgradeCode='344C6454-BC43-4DA0-A8A0-8415508F41DD'
        Manufacturer='momewomo'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='KasaLite - the terminal-only pinned build of kasaterm. Panes, tabs, Korean IME and kasaterm-cli; no characters, board, pet, server or auto-update.'
            Manufacturer='momewomo'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='KasaLite Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='KasaLite'>
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            DiskId='1'
                            Source='app\kasaterm\wix\License.rtf'
                            KeyPath='yes'/>
                    </Component>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='FD032BD9-BE07-4EF1-B6E4-9B51EB760F04' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <!-- 실행 파일 이름이 곧 라이트 표식이다 — 맥 번들의
                             Contents/MacOS/kasaterm-lite 와 같은 이름을 쓴다.
                             package.ps1 이 빌드 산출물을 이 이름으로 스테이징한다. -->
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='kasaterm-lite.exe'
                                DiskId='1'
                                Source='$(var.StageBinDir)\kasaterm-lite.exe'
                                KeyPath='yes'/>
                        </Component>
                        <!-- 크로스-pane RPC + statusline. locate_cmux_compat_binary 가
                             exe 옆에서 찾아 pane PATH(shim dir)에 스테이징한다. -->
                        <Component Id='binary1' Guid='*'>
                            <File
                                Id='kasatermcli'
                                Name='kasaterm-cli.exe'
                                DiskId='1'
                                Source='$(var.StageBinDir)\kasaterm-cli.exe'
                                KeyPath='yes'/>
                        </Component>
                        <Directory Id='AppFonts' Name='fonts'>
                            <Component Id='NotoSansKr' Guid='*'>
                                <File Id='NotoSansKrVariable'
                                    Name='NotoSansKR-Variable.ttf'
                                    DiskId='1'
                                    Source='app\kasaterm\assets\fonts\NotoSansKR-Variable.ttf'
                                    KeyPath='yes'/>
                            </Component>
                            <Component Id='NotoSansKrLicense' Guid='*'>
                                <File Id='NotoSansKrOfl'
                                    Name='OFL-NotoSansKR.txt'
                                    DiskId='1'
                                    Source='app\kasaterm\assets\fonts\OFL-NotoSansKR.txt'
                                    KeyPath='yes'/>
                            </Component>
                        </Directory>
                    </Directory>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='KasaLite'/>
            </Directory>
            <Directory Id='DesktopFolder' Name='Desktop'/>
        </Directory>

        <DirectoryRef Id='ApplicationProgramsFolder'>
            <Component Id='StartMenuShortcut' Guid='*'>
                <Shortcut Id='AppStartMenuShortcut' Name='KasaLite'
                    Description='KasaLite terminal'
                    Target='[Bin]kasaterm-lite.exe' WorkingDirectory='Bin' Icon='ProductICO'/>
                <RemoveFolder Id='RemoveApplicationProgramsFolder' On='uninstall'/>
                <RegistryValue Root='HKCU' Key='Software\KasaLite' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
            </Component>
        </DirectoryRef>
        <DirectoryRef Id='DesktopFolder'>
            <Component Id='DesktopShortcut' Guid='*'>
                <Shortcut Id='AppDesktopShortcut' Name='KasaLite'
                    Description='KasaLite terminal'
                    Target='[Bin]kasaterm-lite.exe' WorkingDirectory='Bin' Icon='ProductICO'/>
                <RegistryValue Root='HKCU' Key='Software\KasaLite' Name='desktop' Type='integer' Value='1' KeyPath='yes'/>
            </Component>
        </DirectoryRef>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and the license.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='License'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='binary1'/>
            <ComponentRef Id='NotoSansKr'/>
            <ComponentRef Id='NotoSansKrLicense'/>
            <ComponentRef Id='StartMenuShortcut'/>
            <ComponentRef Id='DesktopShortcut'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='ProductICO' SourceFile='app\kasaterm\wix\app.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />

        <UI>
            <UIRef Id='WixUI_Minimal'/>
        </UI>

        <WixVariable Id='WixUILicenseRtf' Value='app\kasaterm\wix\License.rtf'/>
        <WixVariable Id='WixUIBannerBmp' Value='app\kasaterm\wix\Banner.bmp'/>
        <WixVariable Id='WixUIDialogBmp' Value='app\kasaterm\wix\Dialog.bmp'/>

    </Product>

</Wix>
