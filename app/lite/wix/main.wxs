<?xml version='1.0' encoding='utf-8'?>
<!--
  KasaLite 의 Windows 설치본. 실행 파일 하나만 깐다 — 칸 안 `kasaterm-cli` 는 같은 exe 를
  칸 shim 폴더에 복사해 쓰고, 글꼴은 시스템 것(Cascadia·Consolas·맑은 고딕)과 exe 에 든
  Nerd 기호를 쓴다.

  ⚠️ UpgradeCode 는 본판과 **절대** 같으면 안 된다. 같으면 MajorUpgrade 가
  둘을 한 제품으로 보고, KasaLite 를 깔 때 설치돼 있던 kasaterm 을 지운다.
  Path 컴포넌트의 고정 GUID 도 같은 이유로 갈라 뒀다(한쪽을 지울 때 남은
  쪽의 PATH 가 함께 사라진다).
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='KasaLite'
        UpgradeCode='344C6454-BC43-4DA0-A8A0-8415508F41DD'
        Manufacturer='momewomo'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='KasaLite - a light, fast terminal. Splits, tabs, Korean IME, kitty and iTerm2 images; drawn by the kasaterm terminal engine.'
            Manufacturer='momewomo'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='KasaLite Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='KasaLite'>
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            DiskId='1'
                            Source='app\lite\wix\License.rtf'
                            KeyPath='yes'/>
                    </Component>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='FD032BD9-BE07-4EF1-B6E4-9B51EB760F04' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <!-- 실행 파일 이름이 곧 라이트 표식이다 — 맥 번들의
                             Contents/MacOS/kasaterm-lite 와 같은 이름을 쓴다.
                             package.ps1 이 빌드 산출물을 이 이름으로 스테이징한다. -->
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='kasaterm-lite.exe'
                                DiskId='1'
                                Source='$(var.StageBinDir)\kasaterm-lite.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='KasaLite'/>
            </Directory>
            <Directory Id='DesktopFolder' Name='Desktop'/>
        </Directory>

        <DirectoryRef Id='ApplicationProgramsFolder'>
            <Component Id='StartMenuShortcut' Guid='*'>
                <Shortcut Id='AppStartMenuShortcut' Name='KasaLite'
                    Description='KasaLite terminal'
                    Target='[Bin]kasaterm-lite.exe' WorkingDirectory='Bin' Icon='ProductICO'/>
                <RemoveFolder Id='RemoveApplicationProgramsFolder' On='uninstall'/>
                <RegistryValue Root='HKCU' Key='Software\KasaLite' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
            </Component>
        </DirectoryRef>
        <DirectoryRef Id='DesktopFolder'>
            <Component Id='DesktopShortcut' Guid='*'>
                <Shortcut Id='AppDesktopShortcut' Name='KasaLite'
                    Description='KasaLite terminal'
                    Target='[Bin]kasaterm-lite.exe' WorkingDirectory='Bin' Icon='ProductICO'/>
                <RegistryValue Root='HKCU' Key='Software\KasaLite' Name='desktop' Type='integer' Value='1' KeyPath='yes'/>
            </Component>
        </DirectoryRef>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and the license.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='License'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='StartMenuShortcut'/>
            <ComponentRef Id='DesktopShortcut'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='ProductICO' SourceFile='app\lite\wix\app.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />

        <UI>
            <UIRef Id='WixUI_Minimal'/>
        </UI>

        <WixVariable Id='WixUILicenseRtf' Value='app\lite\wix\License.rtf'/>
        <WixVariable Id='WixUIBannerBmp' Value='app\lite\wix\Banner.bmp'/>
        <WixVariable Id='WixUIDialogBmp' Value='app\lite\wix\Dialog.bmp'/>

    </Product>

</Wix>
